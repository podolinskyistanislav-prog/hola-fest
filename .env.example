# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only PUBLIC values go here. EXPO_PUBLIC_* variables are bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NEVER put the service_role / secret key here or anywhere in the app.
# It lives only in GitHub Secrets and Supabase Edge Function secrets.
